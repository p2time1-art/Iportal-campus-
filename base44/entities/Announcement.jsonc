{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "title": "School ID"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Short Description"
    },
    "body": {
      "type": "string",
      "title": "Full Content"
    },
    "category": {
      "type": "string",
      "enum": [
        "resumption",
        "examination",
        "pta",
        "sports",
        "events",
        "general",
        "urgent"
      ],
      "default": "general",
      "title": "Category"
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "school",
        "role",
        "class"
      ],
      "default": "school",
      "title": "Audience Type"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "teacher",
        "student",
        "parent"
      ],
      "title": "Target Role"
    },
    "target_class_id": {
      "type": "string",
      "title": "Target Class ID"
    },
    "target_class_name": {
      "type": "string",
      "title": "Target Class Name"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "attachment_url": {
      "type": "string",
      "title": "Attachment URL",
      "format": "uri"
    },
    "attachment_name": {
      "type": "string",
      "title": "Attachment Name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "publish_at": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled Publish Time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expiry Time"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "title": "Show on Public Homepage"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "title": "Pinned"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "expired",
        "archived"
      ],
      "default": "published",
      "title": "Status"
    },
    "author_id": {
      "type": "string",
      "title": "Author User ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    }
  },
  "required": [
    "school_id",
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.is_public": true
            },
            {
              "data.status": "published"
            }
          ]
        },
        {
          "data.school_id": "{{user.data.active_school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}