{
  "name": "ParentGuardian",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "title": "School ID"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "relationship": {
      "type": "string",
      "title": "Relationship",
      "enum": [
        "father",
        "mother",
        "guardian",
        "other"
      ]
    },
    "occupation": {
      "type": "string",
      "title": "Occupation"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "user_id": {
      "type": "string",
      "title": "Linked User Account ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    }
  },
  "required": [
    "school_id",
    "full_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}