{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "title": "School ID"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "student_user_id": {
      "type": "string",
      "title": "Student User ID"
    },
    "admission_number": {
      "type": "string",
      "title": "Admission Number"
    },
    "payment_id": {
      "type": "string",
      "title": "Payment ID"
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number"
    },
    "receipt_date": {
      "type": "string",
      "format": "date",
      "title": "Receipt Date"
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "minimum": 0
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method"
    },
    "payment_reference": {
      "type": "string",
      "title": "Payment Reference"
    },
    "session_name": {
      "type": "string",
      "title": "Session Name"
    },
    "term_name": {
      "type": "string",
      "title": "Term Name"
    },
    "class_name": {
      "type": "string",
      "title": "Class Name"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "generated_by_id": {
      "type": "string",
      "title": "Generated By User ID"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By Name"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "payment_id",
    "receipt_number",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.student_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.active_school_id}}"
            },
            {
              "user_condition": {
                "data.is_school_admin": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}