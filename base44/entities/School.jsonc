{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "School Name"
    },
    "school_code": {
      "type": "string",
      "title": "School Code"
    },
    "short_name": {
      "type": "string",
      "title": "Short Name"
    },
    "motto": {
      "type": "string",
      "title": "Motto"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL",
      "format": "uri"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "country": {
      "type": "string",
      "title": "Country"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "website": {
      "type": "string",
      "title": "Website",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active",
      "title": "Status"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "premium"
      ],
      "default": "basic",
      "title": "Plan"
    },
    "primary_color": {
      "type": "string",
      "title": "Primary Color"
    },
    "accent_color": {
      "type": "string",
      "title": "Accent Color"
    },
    "current_session_id": {
      "type": "string",
      "title": "Current Academic Session ID"
    },
    "application_fee_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Application Fee Enabled"
    },
    "application_fee_amount": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "title": "Application Fee Amount"
    },
    "settings": {
      "type": "object",
      "title": "Settings",
      "properties": {}
    },
    "onboarded_by_id": {
      "type": "string",
      "title": "Onboarded By User ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.active_school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    }
  }
}